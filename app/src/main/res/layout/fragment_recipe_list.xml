<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".Recipe_listFragment">

    <TextView
        android:id="@+id/tvStrictHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available to Cook Now"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@android:color/black"
        />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStrictMatches"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"

        />
    <TextView
    android:id="@+id/tvAlmostHeader"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Missing Just 1 Ingredient"
    android:textStyle="bold"
    android:textSize="18sp"
    android:textColor="@android:color/darker_gray"
      android:layout_marginTop="16dp"
    />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAlmostThereMatches"

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        />

</LinearLayout>