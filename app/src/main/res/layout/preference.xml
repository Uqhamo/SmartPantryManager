<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="Account Profile">
        <Preference
            app:key="profile_info"
            app:title="Logged in as"
            app:summary="user@example.com"/>
    </PreferenceCategory>


    <PreferenceCategory
        app:title="Notification Alerts">
        <SwitchPreferenceCompat
            app:key="key_expiring_soon_alerts"
            app:title="Expiring-Soon Alerts"
            app:summary="Receive alerts when tracked items are expiring soon"
            app:defaultValue="true"/>
    </PreferenceCategory>


    <PreferenceCategory
        app:title="Regional Settings">
        <ListPreference
            app:key="key_unit_preference"
            app:title="Measurement Units"
            app:summary="Choose standard metric or imperial systems"
            app:dialogTitle="Select System"
            app:entries="@array/unit_labels"
            app:entryValues="@array/unit_values"
            app:defaultValue="metric"/>
    </PreferenceCategory>

</PreferenceScreen>
</LinearLayout>